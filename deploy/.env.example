# Postgres: только латиница и цифры, значение идёт в URL
POSTGRES_PASSWORD=

# Redis (без пароля: redis в compose запущен без --requirepass)
REDIS_DB=0

# Notification: времена напоминаний по умолчанию (МСК), вид «M H1,H2,… * * *» (одна минута, до 6 часов, например "0 12,15,18 * * *"); только пока «Настройки» в админке не сохранены
NOTIFICATION_CRON="0 12 * * *"

# Xray: прокси к Telegram (VLESS Reality). Только telegram.org / t.me / telegram.me идут в VPN, остальное напрямую.
# Параметры своего сервера: домен, UUID, публичный ключ Reality (pbk) и short id (sid).
XRAY_DOMAIN=
XRAY_PORT=443
XRAY_UUID=
XRAY_PBK=
XRAY_SID=
XRAY_FINGERPRINT=firefox

# Mini App «Кабинет» (см. ниже, раздел Mini App) и набор compose-файлов.
# Полный стек: docker-compose.yaml:docker-compose.observability.yaml; без Grafana/Loki/Prometheus/Tempo — только docker-compose.yaml
# (install.sh --minimal). Менять значение вручную можно, затем docker compose up -d --remove-orphans.
COMPOSE_FILE=docker-compose.yaml:docker-compose.observability.yaml

# Deploy
BOT_IMAGE_TAG=latest
GRAFANA_PORT=3030
# Домены, с которых открывается Grafana через reverse-proxy (через пробел, без схемы), иначе логин падает с «origin not allowed»
GRAFANA_ALLOWED_ORIGINS=grafana.example.com
GRAFANA_ADMIN_PASSWORD=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Observability (метрики, /healthz, /readyz); в docker-compose зафиксирован ":8081" — его скрейпит Prometheus
OBSERVABILITY_ADDR=":8081"

# Admin api: основной сервер и метрики/healthz
API_ADDR=":8090"
API_OBSERVABILITY_ADDR=":8091"

# Mini App «Кабинет»: origin, с которого он открывается (https://app.bruhanet.ru); пусто — Mini App выключен.
# Тот же адрес читает бот для кнопок на Mini App (отдельной настройки в админке нет).
MINIAPP_ORIGIN=""
