          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "sum(sum_over_time({service=\"bot\"} | json | msg=\"broadcast finished\" | unwrap sent [$__auto]))",
          "legendFormat": "sent"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "B",
          "queryType": "range",
          "expr": "sum(sum_over_time({service=\"bot\"} | json | msg=\"broadcast finished\" | unwrap failed [$__auto]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Последние ошибки и предупреждения",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "maxLines": 100,
          "expr": "{service=\"bot\", level=~\"ERROR|WARN\", level=~\"$level\"} | json | request_id=~\"${request_id:regex}.*\" | telegram_id=~\"${telegram_id:regex}.*\""
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "level": true,
              "msg": true,
              "route": true,
              "telegram_id": true,
              "request_id": true,
              "error": true
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "msg": 2,
              "route": 3,
              "telegram_id": 4,
              "request_id": 5,
              "error": 6
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Time",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Логи бота",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
