      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "sum(count_over_time({service=\"bot\", level=\"ERROR\"} | json | msg=~\".*remnawave.*\" [$__auto]))",
          "legendFormat": "remnawave"
